<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title | escape }}</title>
    {{ content_for_header }}
    {{ 'nexora.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="{{ routes.root_url }}" aria-label="Nexora home">
          <span class="brand-mark">N</span>
          <span>NEXORA</span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          <a href="{{ routes.collections_url }}">Shop</a>
          <a href="{{ routes.search_url }}">Search</a>
          <a href="{{ routes.cart_url }}">Cart <span class="cart-count">{{ cart.item_count }}</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      {{ content_for_layout }}
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>NEXORA LABS</strong><p>Digital commerce, designed for the next move.</p></div>
        <div><span class="eyebrow">DEMO PROJECT</span><p>Built as a real Shopify storefront concept.</p></div>
      </div>
    </footer>
  </body>
</html>
