<section class="nx-cart"><div class="container"><div class="nx-cart-head"><span class="eyebrow">NEXORA CART</span><h1>Your selection.</h1><p>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</p></div>{% if cart.item_count == 0 %}<div class="nx-cart-empty"><p>Your cart is currently empty.</p><a class="nx-btn nx-btn-dark" href="{{ routes.collections_url }}">Discover the collection <span>↗</span></a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="nx-cart-layout"><div class="nx-cart-items">{% for item in cart.items %}<div class="nx-cart-item"><div class="nx-cart-thumb">{% if item.image %}<img src="{{ item.image | image_url: width: 500 }}" alt="{{ item.image.alt | default: item.product.title | escape }}">{% endif %}</div><div class="nx-cart-info"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% unless item.product.has_only_default_variant %}<span>{{ item.variant.title }}</span>{% endunless %}<div class="nx-cart-price">{{ item.final_line_price | money }}</div></div><div class="nx-cart-qty"><label for="qty-{{ item.key }}">Qty</label><input id="qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"></div></div>{% endfor %}<button class="nx-link-button" type="submit" name="update">Update cart</button></div><aside class="nx-summary"><span class="eyebrow">ORDER SUMMARY</span><div class="nx-summary-row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Taxes and shipping calculated at checkout.</p><button class="nx-checkout" type="submit" name="checkout">Secure checkout <span>→</span></button><small>Protected payment · Easy returns · Support when you need it</small></aside></div></form>{% endif %}</div></section><style>.nx-cart{padding:60px 0 110px}.nx-cart-head{padding-bottom:42px;border-bottom:1px solid #ddd}.nx-cart-head h1{font-size:clamp(48px,7vw,88px);line-height:.95;letter-spacing:-.06em;margin:10px 0 18px}.nx-cart-head p{color:#6f7580}.nx-cart-layout{display:grid;grid-template-columns:1.5fr .75fr;gap:55px;padding-top:34px}.nx-cart-item{display:grid;grid-template-columns:140px 1fr auto;gap:22px;padding:20px 0;border-bottom:1px solid #ddd}.nx-cart-thumb{aspect-ratio:1;background:#ecece8;border-radius:18px;overflow:hidden}.nx-cart-thumb img{width:100%;height:100%;object-fit:cover}.nx-cart-info{padding-top:4px}.nx-cart-info a{display:block;text-decoration:none;color:inherit;font-size:16px}.nx-cart-info span{display:block;color:#777d87;font-size:12px;margin-top:6px}.nx-cart-price{margin-top:18px;font-weight:700;font-size:13px}.nx-cart-qty label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#777d87;margin-bottom:7px}.nx-cart-qty input{width:70px;padding:10px;border:1px solid #d6d9de;border-radius:10px;background:#fff}.nx-link-button{margin-top:18px;border:0;background:none;padding:0;text-decoration:underline;font-size:12px;cursor:pointer}.nx-summary{border:1px solid #ddd;border-radius:24px;padding:25px;height:max-content;position:sticky;top:100px}.nx-summary-row{display:flex;justify-content:space-between;align-items:center;margin:28px 0 8px;padding-bottom:20px;border-bottom:1px solid #ddd}.nx-summary p{color:#747a85;font-size:12px;line-height:1.5}.nx-checkout{margin-top:22px;width:100%;padding:17px;border:0;border-radius:999px;background:#111;color:#fff;font-weight:800;display:flex;justify-content:space-between;cursor:pointer}.nx-summary small{display:block;color:#8a909a;font-size:10px;line-height:1.5;text-align:center;margin-top:16px}.nx-cart-empty{padding:85px 0;text-align:center}.nx-cart-empty p{color:#737985;margin-bottom:24px}.nx-btn{display:inline-flex;align-items:center;gap:18px;padding:15px 19px;border-radius:999px;text-decoration:none;font-weight:800;font-size:14px}.nx-btn-dark{background:#111;color:#fff}@media(max-width:850px){.nx-cart-layout{grid-template-columns:1fr}.nx-summary{position:static}.nx-cart-item{grid-template-columns:95px 1fr}.nx-cart-qty{grid-column:2}.nx-cart{padding-top:35px}}{% schema %}{"name":"Nexora cart","settings":[],"presets":[{"name":"Nexora cart"}]}{% endschema %}