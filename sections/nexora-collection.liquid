<section class="nx-collection"><div class="container"><div class="nx-collection-head"><span class="eyebrow">NEXORA COLLECTION</span><h1>{{ collection.title | default: 'The Edit' }}</h1><p>Elevated essentials, selected with intention.</p></div><div class="nx-product-grid">{% for product in collection.products %}<a class="nx-card" href="{{ product.url }}"><div class="nx-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">{% endif %}{% if product.compare_at_price > product.price %}<span class="nx-badge">SAVE</span>{% endif %}</div><div class="nx-card-row"><div><h3>{{ product.title }}</h3><p>{{ product.vendor | default: 'Nexora selection' }}</p></div><div class="nx-price">{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}<strong>{{ product.price | money }}</strong></div></div></a>{% else %}<p>No products in this collection yet.</p>{% endfor %}</div></div></section><style>.nx-collection{padding:72px 0 110px}.nx-collection-head{padding:30px 0 58px;border-bottom:1px solid #ddd;margin-bottom:32px}.nx-collection-head h1{font-size:clamp(52px,8vw,100px);line-height:.92;letter-spacing:-.06em;margin:10px 0 20px}.nx-collection-head p{color:#6b717c;font-size:17px}</style>{% schema %}{"name":"Nexora collection","settings":[],"presets":[{"name":"Nexora collection"}]}{% endschema %}