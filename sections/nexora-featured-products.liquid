<section id="featured" class="nx-products">
  <div class="container">
    <div class="nx-section-head"><div><span class="eyebrow">EDIT / 01</span><h2>{{ section.settings.title }}</h2></div><a class="nx-link" href="{{ routes.collections_url }}">Shop all ↗</a></div>
    <div class="nx-product-grid">
      {% assign shown = 0 %}
      {% for product in collections.all.products limit: 6 %}
        {% assign shown = shown | plus: 1 %}
        <a class="nx-card" href="{{ product.url }}">
          <div class="nx-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">{% else %}<div class="nx-placeholder"></div>{% endif %}<span class="nx-badge">{{ product.type | default: 'Featured' }}</span></div>
          <div class="nx-card-row"><div><h3>{{ product.title }}</h3><p>{{ product.vendor | default: 'Nexora selection' }}</p></div><div class="nx-price">{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}<strong>{{ product.price | money }}</strong></div></div>
        </a>
      {% endfor %}
    </div>
    {% if shown == 0 %}<div class="nx-empty">Add products to your store to populate this collection.</div>{% endif %}
  </div>
</section>
<style>
.nx-products{padding:95px 0}.nx-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:32px}.nx-section-head h2{font-size:clamp(32px,4vw,56px);letter-spacing:-.045em;margin:8px 0 0}.nx-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.nx-card{text-decoration:none;color:inherit}.nx-media{position:relative;aspect-ratio:1/1.12;background:#ecece8;border-radius:22px;overflow:hidden}.nx-media img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}.nx-card:hover .nx-media img{transform:scale(1.035)}.nx-badge{position:absolute;left:14px;top:14px;padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.85);backdrop-filter:blur(10px);font-size:10px;font-weight:800;letter-spacing:.1em}.nx-card-row{display:flex;justify-content:space-between;gap:15px;padding:16px 4px}.nx-card h3{font-size:16px;margin:0 0 5px}.nx-card p{font-size:12px;color:#777d88;margin:0}.nx-price{text-align:right;font-size:14px;white-space:nowrap}.nx-price del{display:block;color:#979ca5;font-size:11px}.nx-price strong{font-size:15px}.nx-empty{padding:60px;border:1px dashed #c9ccd1;border-radius:20px;text-align:center;color:#727782}@media(max-width:900px){.nx-product-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.nx-products{padding:68px 0}.nx-product-grid{grid-template-columns:1fr}.nx-section-head{align-items:start}.nx-section-head .nx-link{display:none}}
</style>
{% schema %}{"name":"Nexora featured products","settings":[{"type":"text","id":"title","label":"Title","default":"Curated for the next move"}],"presets":[{"name":"Nexora featured products"}]}{% endschema %}
