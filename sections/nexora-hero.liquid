</section>
<style>
.nx-hero-v2{position:relative;min-height:calc(100svh - 82px);height:780px;max-height:900px;overflow:hidden;background:#101113;color:#fff}.nx-hero-v2-media{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=2200&q=92');background-size:cover;background-position:center 38%;transform:scale(1.035);animation:nxV2Zoom 1.8s cubic-bezier(.2,.7,.2,1) both}.nx-hero-v2-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,6,8,.82) 0%,rgba(5,6,8,.45) 42%,rgba(5,6,8,.08) 78%),linear-gradient(0deg,rgba(5,6,8,.72),transparent 42%,rgba(5,6,8,.22))}.nx-hero-v2-content{height:100%;position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;padding-top:34px;padding-bottom:30px}.nx-hero-v2-top{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.18em;font-weight:850;opacity:.82;border-bottom:1px solid rgba(255,255,255,.24);padding-bottom:18px}.nx-hero-v2-main{max-width:850px;margin-top:auto;margin-bottom:auto;padding-top:50px}.nx-hero-v2-kicker{font-size:10px;letter-spacing:.2em;font-weight:900;margin:0 0 22px;color:#c7ff1a}.nx-hero-v2-main h1{font-size:clamp(68px,9vw,142px);line-height:.82;letter-spacing:-.075em;margin:0}.nx-hero-v2-main h1 i{font-family:Georgia,serif;font-weight:400;letter-spacing:-.065em}.nx-hero-v2-lead{max-width:490px;font-size:15px;line-height:1.65;color:rgba(255,255,255,.78);margin:30px 0}.nx-hero-v2-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.nx-hero-v2-primary{display:inline-flex;align-items:center;gap:22px;padding:17px 21px;background:#c7ff1a;color:#08090b;text-decoration:none;border-radius:999px;font-size:12px;font-weight:900;transition:transform .35s,box-shadow .35s}.nx-hero-v2-primary span{font-size:18px;font-weight:400}.nx-hero-v2-primary:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(199,255,26,.2)}.nx-hero-v2-secondary{color:#fff;text-decoration:none;font-size:12px;font-weight:800;border-bottom:1px solid rgba(255,255,255,.65);padding-bottom:5px}.nx-hero-v2-secondary span{display:inline-block;margin-left:8px;transition:transform .3s}.nx-hero-v2-secondary:hover span{transform:translateY(4px)}.nx-hero-v2-bottom{display:grid;grid-template-columns:repeat(3,1fr) 2fr;gap:20px;align-items:end;border-top:1px solid rgba(255,255,255,.24);padding-top:18px}.nx-hero-v2-bottom>div:not(.nx-hero-v2-scroll){display:flex;gap:13px;align-items:flex-start}.nx-hero-v2-bottom b{font-size:10px;color:#c7ff1a}.nx-hero-v2-bottom span{font-size:8px;line-height:1.35;letter-spacing:.15em;font-weight:850;opacity:.78}.nx-hero-v2-scroll{justify-self:end;display:flex;align-items:center;gap:10px;font-size:8px;letter-spacing:.15em;font-weight:850;opacity:.75}.nx-hero-v2-scroll span{width:35px;height:1px;background:#fff;display:block;position:relative}.nx-hero-v2-scroll span:after{content:'';position:absolute;right:0;top:-3px;width:6px;height:6px;border-right:1px solid #fff;border-bottom:1px solid #fff;transform:rotate(-45deg)}.nx-marquee{overflow:hidden;background:#c7ff1a;color:#0a0b0e;border-bottom:1px solid #0a0b0e}.nx-marquee-track{width:max-content;display:flex;align-items:center;gap:34px;padding:13px 0;animation:nxMarquee 24s linear infinite;font-size:10px;letter-spacing:.15em;font-weight:950}.nx-marquee-track b{font-size:13px}@keyframes nxV2Zoom{from{opacity:0;transform:scale(1.12)}to{opacity:1;transform:scale(1.035)}}@keyframes nxMarquee{to{transform:translateX(-50%)}}@media(max-width:700px){.nx-hero-v2{height:720px;min-height:720px}.nx-hero-v2-media{background-position:62% center}.nx-hero-v2-overlay{background:linear-gradient(90deg,rgba(5,6,8,.72),rgba(5,6,8,.25)),linear-gradient(0deg,rgba(5,6,8,.86),transparent 55%)}.nx-hero-v2-content{padding-top:22px;padding-bottom:22px}.nx-hero-v2-main{padding-top:40px}.nx-hero-v2-main h1{font-size:clamp(58px,16vw,86px)}.nx-hero-v2-lead{font-size:14px}.nx-hero-v2-bottom{grid-template-columns:repeat(3,1fr);gap:10px}.nx-hero-v2-scroll{display:none}.nx-hero-v2-bottom>div:not(.nx-hero-v2-scroll){gap:7px}.nx-hero-v2-bottom span{font-size:7px}.nx-hero-v2-top{font-size:8px}}
@media(prefers-reduced-motion:reduce){.nx-hero-v2-media,.nx-marquee-track{animation:none}}
</style>
