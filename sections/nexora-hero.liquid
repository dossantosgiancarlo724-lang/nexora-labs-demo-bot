<section class="nx-hero nx-reveal">
  <div class="nx-hero-glow nx-glow-a"></div><div class="nx-hero-glow nx-glow-b"></div>
  <div class="container nx-hero-shell">
    <div class="nx-hero-copy">
      <div class="nx-kicker"><span class="nx-dot"></span>NEXORA LABS · DEMO PROJECT</div>
      <h1>Objects made<br><em>to move you.</em></h1>
      <p class="nx-lead">A curated collection of modern essentials, presented through a high-end Shopify shopping experience.</p>
      <div class="nx-actions"><a class="nx-btn nx-btn-dark nx-magnetic" href="{{ routes.collections_url }}"><span>Shop the collection</span><b>↗</b></a><a class="nx-link" href="#featured">Explore the edit <span>↓</span></a></div>
      <div class="nx-hero-meta"><span>NEW SEASON · 2026</span><span>FREE SHIPPING OVER €80</span><span>SECURE CHECKOUT</span></div>
    </div>
    <div class="nx-hero-visual nx-tilt">
      <div class="nx-hero-image"></div><div class="nx-image-shine"></div>
      <div class="nx-floating nx-floating-top nx-float-a"><span>01</span><strong>THE EVERYDAY EDIT</strong></div>
      <div class="nx-floating nx-floating-bottom nx-float-b"><span>NEW</span><strong>Designed to last.</strong><small>Explore ↓</small></div>
      <div class="nx-hero-corner">N / 01</div>
    </div>
  </div>
  <div class="nx-scroll-cue"><i></i>SCROLL TO EXPLORE</div>
</section>
<style>
.nx-hero{position:relative;padding:34px 0 0;background:#f4f3ef;overflow:hidden}.nx-hero-shell{display:grid;grid-template-columns:.9fr 1.1fr;min-height:690px;position:relative;z-index:2}.nx-hero-copy{padding:92px 20px 50px 0;display:flex;flex-direction:column;animation:nxUp .9s cubic-bezier(.2,.7,.2,1) both}.nx-kicker{font-size:10px;letter-spacing:.16em;font-weight:900;color:#686d76;display:flex;align-items:center;gap:9px}.nx-dot{width:7px;height:7px;border-radius:50%;background:#b9ff00;box-shadow:0 0 0 4px rgba(185,255,0,.18);animation:nxPulse 2s infinite}.nx-hero h1{font-size:clamp(58px,7vw,104px);line-height:.88;letter-spacing:-.075em;margin:34px 0 0}.nx-hero h1 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.07em}.nx-lead{max-width:500px;font-size:17px;line-height:1.65;color:#646a74;margin:35px 0 30px}.nx-actions{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.nx-btn{display:inline-flex;align-items:center;gap:18px;padding:17px 22px;border-radius:999px;text-decoration:none;font-weight:850;font-size:13px;transition:transform .25s,box-shadow .25s}.nx-btn-dark{background:#0b0c0f;color:#fff;box-shadow:0 14px 35px rgba(0,0,0,.16)}.nx-btn-dark b{font-size:18px;font-weight:400}.nx-btn-dark:hover{box-shadow:0 20px 45px rgba(0,0,0,.23)}.nx-link{font-size:13px;font-weight:800;color:#111;text-decoration:none;border-bottom:1px solid #111;padding-bottom:4px}.nx-link span{display:inline-block;transition:transform .25s}.nx-link:hover span{transform:translateY(4px)}.nx-hero-meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:auto;padding-top:20px;border-top:1px solid #d5d3cd;font-size:9px;letter-spacing:.13em;font-weight:850;color:#777c85}.nx-hero-visual{position:relative;min-height:690px;background:#ddd;overflow:hidden;transform-style:preserve-3d}.nx-hero-image{position:absolute;inset:-2%;background-image:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.18)),url('https://images.unsplash.com/photo-1492707892479-7bc8d5a4ee93?auto=format&fit=crop&w=1600&q=90');background-size:cover;background-position:center;transition:transform 1.2s cubic-bezier(.2,.7,.2,1);animation:nxZoom 1.4s ease both}.nx-hero-visual:hover .nx-hero-image{transform:scale(1.045)}.nx-image-shine{position:absolute;inset:0;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.25) 48%,transparent 55%);transform:translateX(-120%);animation:nxShine 4s 1s infinite}.nx-floating{position:absolute;background:rgba(250,249,245,.94);backdrop-filter:blur(16px);box-shadow:0 18px 50px rgba(0,0,0,.14);padding:17px 19px;transition:transform .4s}.nx-floating span{display:block;font-size:9px;letter-spacing:.15em;font-weight:900;color:#777;margin-bottom:9px}.nx-floating strong{display:block;font-size:14px;letter-spacing:-.02em}.nx-floating small{display:block;margin-top:9px;color:#777;font-size:10px}.nx-floating-top{top:34px;left:-32px;min-width:190px}.nx-floating-bottom{right:28px;bottom:28px;min-width:185px}.nx-floating-bottom span{color:#111}.nx-floating-bottom span:before{content:'● ';color:#b9ff00}.nx-floating:hover{transform:translateY(-8px)}.nx-hero-corner{position:absolute;right:22px;top:22px;color:white;font-size:9px;letter-spacing:.16em;font-weight:900;mix-blend-mode:difference}.nx-scroll-cue{display:flex;align-items:center;gap:12px;position:absolute;right:30px;bottom:28px;font-size:9px;letter-spacing:.16em;font-weight:900;z-index:3}.nx-scroll-cue i{width:30px;height:1px;background:#111;display:block;position:relative}.nx-scroll-cue i:after{content:'';position:absolute;right:0;top:-3px;width:7px;height:7px;border-right:1px solid #111;border-bottom:1px solid #111;transform:rotate(-45deg)}.nx-hero-glow{position:absolute;border-radius:50%;filter:blur(50px);pointer-events:none}.nx-glow-a{width:300px;height:300px;right:10%;top:4%;background:rgba(185,255,0,.12);animation:nxDrift 8s ease-in-out infinite}.nx-glow-b{width:260px;height:260px;left:-5%;bottom:10%;background:rgba(80,90,255,.08);animation:nxDrift 10s 1s ease-in-out infinite reverse}@keyframes nxUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}@keyframes nxZoom{from{transform:scale(1.08)}to{transform:scale(1)}}@keyframes nxShine{0%,55%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}@keyframes nxPulse{0%,100%{box-shadow:0 0 0 4px rgba(185,255,0,.18)}50%{box-shadow:0 0 0 10px rgba(185,255,0,0)}}@keyframes nxDrift{50%{transform:translate(25px,-18px) scale(1.08)}}@media(max-width:900px){.nx-hero-shell{grid-template-columns:1fr}.nx-hero-copy{padding:70px 0 45px;min-height:530px}.nx-hero-visual{min-height:560px}.nx-floating-top{left:18px}.nx-scroll-cue{display:none}}@media(max-width:560px){.nx-hero{padding-top:0}.nx-hero-copy{padding-top:55px}.nx-hero h1{font-size:58px}.nx-lead{font-size:16px}.nx-hero-visual{min-height:480px}.nx-floating{padding:13px}.nx-floating-top{top:16px;left:12px}.nx-floating-bottom{right:12px;bottom:16px}.nx-hero-meta{gap:10px}}
</style>
