<section class="nx-hero">
  <div class="container nx-hero-shell">
    <div class="nx-hero-copy">
      <div class="nx-kicker"><span class="nx-dot"></span>NEXORA LABS · DEMO PROJECT</div>
      <h1>Objects made<br><em>to move you.</em></h1>
      <p class="nx-lead">A curated collection of modern essentials, presented through a high-end Shopify shopping experience.</p>
      <div class="nx-actions">
        <a class="nx-btn nx-btn-dark" href="{{ routes.collections_url }}">Shop the collection <span>↗</span></a>
        <a class="nx-link" href="#featured">Explore the edit</a>
      </div>
      <div class="nx-hero-meta"><span>NEW SEASON · 2026</span><span>FREE SHIPPING OVER €80</span><span>SECURE CHECKOUT</span></div>
    </div>
    <div class="nx-hero-visual">
      <div class="nx-hero-image"></div>
      <div class="nx-floating nx-floating-top"><span>01</span><strong>THE EVERYDAY EDIT</strong></div>
      <div class="nx-floating nx-floating-bottom"><span>NEW</span><strong>Designed to last.</strong><small>Explore ↓</small></div>
    </div>
  </div>
</section>
<style>
.nx-hero{padding:34px 0 0;background:#f4f3ef;overflow:hidden}.nx-hero-shell{display:grid;grid-template-columns:.9fr 1.1fr;min-height:690px}.nx-hero-copy{padding:92px 20px 50px 0;display:flex;flex-direction:column}.nx-kicker{font-size:10px;letter-spacing:.16em;font-weight:900;color:#686d76;display:flex;align-items:center;gap:9px}.nx-dot{width:7px;height:7px;border-radius:50%;background:#b9ff00;box-shadow:0 0 0 4px rgba(185,255,0,.18)}.nx-hero h1{font-size:clamp(58px,7vw,104px);line-height:.88;letter-spacing:-.075em;margin:34px 0 0}.nx-hero h1 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.07em}.nx-lead{max-width:500px;font-size:17px;line-height:1.65;color:#646a74;margin:35px 0 30px}.nx-actions{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.nx-btn{display:inline-flex;align-items:center;gap:18px;padding:17px 22px;border-radius:999px;text-decoration:none;font-weight:850;font-size:13px}.nx-btn-dark{background:#0b0c0f;color:#fff;box-shadow:0 14px 35px rgba(0,0,0,.16)}.nx-btn-dark span{font-size:18px}.nx-link{font-size:13px;font-weight:800;color:#111;text-decoration:none;border-bottom:1px solid #111;padding-bottom:4px}.nx-hero-meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:auto;padding-top:20px;border-top:1px solid #d5d3cd;font-size:9px;letter-spacing:.13em;font-weight:850;color:#777c85}.nx-hero-visual{position:relative;min-height:690px;background:#ddd}.nx-hero-image{position:absolute;inset:0;background-image:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.18)),url('https://images.unsplash.com/photo-1492707892479-7bc8d5a4ee93?auto=format&fit=crop&w=1600&q=90');background-size:cover;background-position:center}.nx-floating{position:absolute;background:rgba(250,249,245,.94);backdrop-filter:blur(16px);box-shadow:0 18px 50px rgba(0,0,0,.14);padding:17px 19px}.nx-floating span{display:block;font-size:9px;letter-spacing:.15em;font-weight:900;color:#777;margin-bottom:9px}.nx-floating strong{display:block;font-size:14px;letter-spacing:-.02em}.nx-floating small{display:block;margin-top:9px;color:#777;font-size:10px}.nx-floating-top{top:34px;left:-32px;min-width:190px}.nx-floating-bottom{right:28px;bottom:28px;min-width:185px}.nx-floating-bottom span{color:#111}.nx-floating-bottom span:before{content:'● ';color:#b9ff00}@media(max-width:900px){.nx-hero-shell{grid-template-columns:1fr}.nx-hero-copy{padding:70px 0 45px;min-height:530px}.nx-hero-visual{min-height:560px}.nx-floating-top{left:18px}.nx-hero-meta{margin-top:55px}}@media(max-width:560px){.nx-hero{padding-top:0}.nx-hero-copy{padding-top:55px}.nx-hero h1{font-size:58px}.nx-lead{font-size:16px}.nx-hero-visual{min-height:480px}.nx-floating{padding:13px}.nx-floating-top{top:16px;left:12px}.nx-floating-bottom{right:12px;bottom:16px}}
</style>
