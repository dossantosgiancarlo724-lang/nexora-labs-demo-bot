<section class="nx-pdp"><div class="container nx-pdp-grid"><div class="nx-pdp-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | escape }}">{% endif %}<span class="nx-pdp-stamp">NEXORA / PRODUCT 01</span></div><div class="nx-pdp-copy"><span class="eyebrow">{{ product.vendor | default: 'NEXORA EDIT' }}</span><h1>{{ product.title }}</h1><div class="nx-pdp-price">{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}<strong>{{ product.price | money }}</strong></div><div class="nx-rating">★★★★★ <span>4.9 · 128 verified reviews</span></div><p class="nx-desc">{{ product.description | strip_html | truncatewords: 38 | default: 'A considered everyday essential with premium materials, precise finishing and a refined silhouette.' }}</p><form method="post" action="{{ routes.cart_add_url }}" class="nx-buy"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit">Add to cart <span>→</span></button></form><div class="nx-service"><div><strong>Complimentary delivery</strong><span>Orders over €75</span></div><div><strong>Easy returns</strong><span>30 day return window</span></div><div><strong>Secure checkout</strong><span>Protected payment</span></div></div></div></div></section><style>.nx-pdp{padding:48px 0 90px}.nx-pdp-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);gap:70px;align-items:start}.nx-pdp-media{position:relative;background:#ecece8;border-radius:28px;overflow:hidden;aspect-ratio:1/1.08}.nx-pdp-media img{width:100%;height:100%;object-fit:cover}.nx-pdp-stamp{position:absolute;bottom:18px;left:18px;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);padding:9px 11px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.11em}.nx-pdp-copy{padding-top:30px}.nx-pdp-copy h1{font-size:clamp(40px,5vw,70px);line-height:.95;letter-spacing:-.055em;margin:12px 0 25px}.nx-pdp-price{font-size:19px;margin-bottom:15px}.nx-pdp-price del{color:#989da5;font-size:13px;margin-right:8px}.nx-pdp-price strong{font-size:22px}.nx-rating{font-size:13px;letter-spacing:.08em;margin-bottom:25px}.nx-rating span{letter-spacing:0;color:#727782;margin-left:7px}.nx-desc{font-size:15px;line-height:1.65;color:#636a75;max-width:540px}.nx-buy{margin:30px 0}.nx-buy button{width:100%;border:0;background:#111;color:#fff;border-radius:999px;padding:18px 21px;font-size:14px;font-weight:800;display:flex;justify-content:space-between;cursor:pointer}.nx-service{border-top:1px solid #ddd}.nx-service>div{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #ddd;font-size:12px}.nx-service strong{font-size:13px}.nx-service span{color:#777d87}@media(max-width:900px){.nx-pdp-grid{grid-template-columns:1fr;gap:25px}.nx-pdp-copy{padding-top:0}}@media(max-width:600px){.nx-pdp{padding-top:20px}.nx-pdp-copy h1{font-size:42px}.nx-rating span{display:block;margin:8px 0 0}}</style>{% schema %}{"name":"Nexora product","settings":[],"presets":[{"name":"Nexora product"}]}{% endschema %}