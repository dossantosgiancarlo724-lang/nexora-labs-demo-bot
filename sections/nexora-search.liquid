<section class="nx-search-page"><div class="container"><div class="nx-page-head"><span class="eyebrow">SEARCH</span><h1>Find your next essential.</h1><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="NexoraSearch">Search products</label><input id="NexoraSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, categories..." autocomplete="off"><button type="submit">Search</button></form></div>{% if search.performed %}<p class="nx-results-count">{{ search.results_count }} results</p><div class="nx-search-grid">{% for item in search.results %}<a class="nx-search-card" href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 700 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy">{% endif %}<div><h2>{{ item.title }}</h2><p>{{ item.price | money }}</p></div></a>{% else %}<div class="nx-empty">No results found. Try another search.</div>{% endfor %}</div>{% endif %}</div></section><style>.nx-search-page{padding:90px 0 120px}.nx-page-head{max-width:850px;margin-bottom:55px}.nx-page-head h1{font-size:clamp(42px,6vw,78px);letter-spacing:-.055em;margin:10px 0 32px}.nx-page-head form{display:flex;gap:10px}.nx-page-head input{flex:1;border:1px solid #d4d6da;border-radius:999px;padding:16px 20px;font-size:15px;background:#fff}.nx-page-head button{border:0;border-radius:999px;padding:0 25px;background:#111;color:#fff;font-weight:800}.nx-results-count{color:#707580}.nx-search-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.nx-search-card{text-decoration:none;color:inherit}.nx-search-card img{width:100%;aspect-ratio:1/1.08;object-fit:cover;border-radius:20px;background:#eee}.nx-search-card h2{font-size:17px;margin:15px 0 5px}.nx-search-card p{margin:0;color:#60656e}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.nx-search-page{padding:60px 0 80px}.nx-page-head form{display:grid}.nx-page-head button{padding:15px}.nx-search-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.nx-search-grid{grid-template-columns:1fr}}</style>{% schema %}{"name":"Nexora search","settings":[],"presets":[{"name":"Nexora search"}]}{% endschema %}